{%
  set classes = [
    'block',
    'block-menu',
    'navigation',
    'menu--' ~ derivative_plugin_id|clean_class,
    'menu',
    'open-current-submenu',
  ]
%}
<nav id="menuacc" role="navigation" aria-labelledby="{{ heading_id }}"{{ attributes.addClass(classes)|without('role', 'aria-labelledby') }}>
  {# Menu. #}
  {% block content %}
    {{ content }}
  {% endblock %}
</nav>