{% include "@koecontrato/layout/header.html.twig" %}

<div class="page-content page_theme page_front-koe">
  {# System #}
  {% if page.system %}
    <section class="system-content_theme">
      <div class="container"> 
        <div class="row clearfix">
          <div class="col-12"> 
            {{ page.system }}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
  {% if page.content %}
    <section class="main-content_theme">
      <div class="container koe-node"> 
        <div class="row clearfix">
          <div class="col-12">
            <h3 class="titulo-folio">BITÁCORA</h3>
            <div class="banner-img banner-bitacora"></div>
          </div>
          <div class="col-12"> 
            {{ page.content }}
          </div>
        </div>
      </div>
    </section> 
  {% endif %}
  
</div>

<div id="km-modal-loading" class="mfp-hide km-loading">
  <div class="km-txtload">Procesando</div>
  <div class="km-load"><hr/><hr/><hr/><hr/></div>
</div>

{% include "@koecontrato/layout/footer.html.twig" %}