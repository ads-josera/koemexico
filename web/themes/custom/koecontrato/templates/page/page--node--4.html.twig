<div class="page-content page_theme page-pop">
  {# System #}
  {% if page.system %}
    <section class="system-content_theme">
      <div class="container"> 
        <div class="row clearfix">
          <div class="col-12"> 
            {{ page.system }}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
  {# Main content #}
  {% if page.content %}
    <section class="main-content_theme">
      <div class="container-fluid p-0 koe-node"> 
        <div class="row clearfix">
          <div class="col-10 p-0 m-auto"> 
            {{ page.content }}
          </div>
        </div>
      </div>
    </section> 
  {% endif %}
  
</div>