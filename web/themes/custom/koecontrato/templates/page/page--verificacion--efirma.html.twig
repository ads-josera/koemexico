{% include "@koecontrato/layout/header.html.twig" %}

<div class="page-content page_theme page_front-koe">
  {# System #}
  {% if page.system %}
    <section class="system-content_theme">
      <div class="container"> 
        <div class="row clearfix">
          <div class="col-12"> 
            {{ page.system }}
          </div>
        </div>
      </div>
    </section>
  {% endif %}
  {% if page.content %}
    <section class="main-content_theme">
      <div class="container koe-node"> 
        <div class="row clearfix">
        {% if 'verificador' in user.getroles(TRUE) %}
          <div class="col-12 encabezado-rol encabezado-ejecutivo">
            <h3 class="titulo-folio">VERIFICACIÓN</h3>
            <div class="banner-img banner-wee"></div>
          </div>
        {% endif %}
          <div class="col-12"> 
            {{ page.content }}
          </div>
        </div>
      </div>
    </section> 
  {% endif %}
  
</div>


{% include "@koecontrato/layout/footer.html.twig" %}