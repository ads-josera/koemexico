<div class="page-content user-login">

  <section class="login">
    <div class="container">
      <div class="row">

        <div class="col-lg-6 col-md-10 mx-auto align-self-center">
          <div class="login-form p-4">
            <a class="main-logo d-block p-0 w-50 text-center m-auto" href="{{ path('<front>') }}"rel="home">
              <img class="logo-user-page" src="{{ base_path ~ directory }}/logo-white.svg"/>
            </a>

            <h1 class="titulo-login">Acceso Venta</h1>

            {# System #}
            {% if page.system %}
              <div class="system-content_theme"> 
                {{ page.system }}
              </div>
            {% endif %}
            
            <div class="formulario-login"> 
              {{ page.content }}
            </div>

            <div class="copy-login">© {{ "now"|date('Y') }} KOE México | Todos los derechos reservados</div>

          </div>
        </div>
      </div>

    </div>
  </section>

</div>

        