{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal 9 projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "npm-assets": {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    },
    "require": {
        "aws/aws-sdk-php": "^3.0",
        "composer/installers": "^1.9",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "^3.6",
        "drupal/autologout": "^2.0",
        "drupal/better_exposed_filters": "^7.0",
        "drupal/classy": "^1.0",
        "drupal/clientside_validation": "^4.0",
        "drupal/coffee": "^2.0",
        "drupal/composer_deploy": "^1.7",
        "drupal/core-composer-scaffold": "^10.4",
        "drupal/core-project-message": "^10.4",
        "drupal/core-recommended": "^10.4",
        "drupal/ctools": "^4.0",
        "drupal/dev_mode": "^2.4",
        "drupal/devel": "^5.4",
        "drupal/devel_entity_updates": "^4.2",
        "drupal/devel_kint_extras": "^1.1",
        "drupal/disable_messages": "^2.1",
        "drupal/entityreference_filter": "^2.0@beta",
        "drupal/honeypot": "^2.2",
        "drupal/jquery_ui": "^1.7",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/jquery_ui_slider": "^2.1",
        "drupal/jquery_ui_touch_punch": "^1.1",
        "drupal/kint-kint": "^2.1",
        "drupal/login_redirect_per_role": "^1.11",
        "drupal/mail_login": "^4.2",
        "drupal/mailsystem": "^4.4",
        "drupal/mediteran": "^1.27",
        "drupal/menu_link_attributes": "^1.2",
        "drupal/pathauto": "^1.10",
        "drupal/pdf": "^1.1",
        "drupal/permissions_by_term": "^3.1",
        "drupal/queue_ui": "^3.2",
        "drupal/search_api": "^1.24",
        "drupal/smtp": "^1.0",
        "drupal/telephone_validation": "^2.3",
        "drupal/toastr": "^2.0@beta",
        "drupal/token": "^1.16",
        "drupal/twig_field_value": "^2.0",
        "drupal/twig_tweak": "^3.4",
        "drupal/verf": "^2.0",
        "drupal/views_bulk_operations": "*",
        "drupal/webform": "^6.1",
        "google/apiclient": "^2.12.1",
        "hybridauth/hybridauth": "^3.8",
        "kint-php/kint": "^6.0",
        "npm-asset/jquery-validation": "^1.17",
        "oomphinc/composer-installers-extender": "^2.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.3",
        "wikimedia/composer-merge-plugin": "^2.0"
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "wikimedia/composer-merge-plugin": true,
            "oomphinc/composer-installers-extender": true
        },
        "platform": {
            "php": "8.1"
        }
    },
    "extra": {
        "patches": {
            "drupal/webform": {
                "Progress bar disappears on server validation error when using webform cards": "https://www.drupal.org/files/issues/2022-05-10/3274011-5.patch",
                "Update jquery.intl-tel-input to v23.0.10 and add option for i18n": "https://www.drupal.org/files/issues/2025-03-31/webform-3452986-18-update_jquery_intl_tel_input_to_v23_0_10.patch"
            }
        },
        "google/apiclient-services": [
            "Drive"
        ],
        "merge-plugin": {
            "include": [
                "web/modules/contrib/webform/composer.libraries.json"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-types": [
            "npm-asset"
        ],
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/8/install",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        }
    },
    "require-dev": {
        "drush/drush": "^12"
    }
}
